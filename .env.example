# Copy to .env for local cloud testing. Never commit .env or paste secret keys into chat.
# Leave 0 to run the existing local simulation. Vercel automatically enables cloud mode.
FIREGUARD_CLOUD=0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public browser key: Supabase publishable key or legacy anon key.
SUPABASE_ANON_KEY=
# Server only: Supabase secret key or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Server + Pi only. Generate a random token of at least 32 characters.
FIREGUARD_DEVICE_TOKEN=
FIREGUARD_DEVICE_ID=pi-01
FIREGUARD_STALE_SECONDS=15
